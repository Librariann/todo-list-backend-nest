PORT=8080
# 여러 개는 쉼표로 구분한다. (운영 + Vercel 프리뷰 배포 등)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
MOBILE_OAUTH_REDIRECT_URI=growdo://oauth/callback
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
DATABASE_URL=postgresql://postgres:replace-with-password@localhost:5432/postgres
DB_SCHEMA=todo_list
DB_SYNC=false
JWT_SECRET=replace-with-at-least-64-random-characters
JWT_ACCESS_EXPIRES_MS=86400000
JWT_REFRESH_EXPIRES_MS=604800000
REDIS_URL=redis://localhost:6379
# EAS에서 Enhanced Push Security를 활성화한 운영 환경에서 설정한다.
EXPO_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
KAKAO_CLIENT_ID=replace-with-kakao-client-id
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Apple Developer의 Sign in with Apple 키(.p8)는 줄바꿈을 \\n으로 넣는다.
APPLE_CLIENT_ID=com.growdo.app
# 웹과 Android 브라우저 로그인에 사용하는 Apple Services ID
APPLE_SERVICE_ID=com.growdo.web
# Apple Developer에 등록할 HTTPS Return URL
APPLE_REDIRECT_URI=https://api.example.com/login/oauth2/code/apple
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- 관측(Observability) ---
# 로그 레벨: trace|debug|info|warn|error (기본: 운영 info, 그 외 debug)
LOG_LEVEL=
# Sentry 프로젝트 DSN. 비워두면 에러 리포팅이 비활성화된다.
SENTRY_DSN=
# 성능 추적 샘플링 비율(0~1). 기본 0 = 끔. 필요하면 0.1부터 올린다.
SENTRY_TRACES_SAMPLE_RATE=0
# Slack Incoming Webhook URL. 비워두면 슬랙 알림이 비활성화된다.
SLACK_WEBHOOK_URL=
# 동일 알림을 이 시간(분) 동안 한 번만 보낸다.
SLACK_ALERT_DEDUP_MINUTES=10
# 5분당 최대 전송 건수 (장애 시 웹훅 폭주 방지)
SLACK_ALERT_MAX_PER_5MIN=20
# 서버 기동 알림을 끄려면 false
SLACK_NOTIFY_STARTUP=true
